{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": false,
		"declaration": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": false,
		"noEmitOnError": true,
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
